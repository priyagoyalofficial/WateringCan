# Copy this file to .env and fill it in. .env is ignored by git - never commit your key.

# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# WATERING_CAN_MODEL=claude-opus-5

# Daily reminder email (optional). For Gmail, create an app password at
# https://myaccount.google.com/apppasswords and use it below (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# REMINDER_TO=you@gmail.com
